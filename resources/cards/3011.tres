[ext_resource type="Script" path="res://src/Cards/Resources/CardDataResource.cs" id="1_card"]

[resource]
script = ExtResource("1_card")
Name = "摄政议会"
Description = "每当你抽取一张牌，你获得1层「议案」计数。
开幕：选择一张手牌洗入牌库，并抽等量的牌。若打出过的「摄政议会」大于1张，洗入任意张手牌而非一张。
启动0（冷却1）：消耗所有的「议案」计数，若消耗的层数大于5，则抽取一张牌。大于10，则额外将所有手牌洗入牌库并抽取等量的牌。大于20，则额外破坏所有的敌方随从。大于30，则额外在本局对战的剩余时间内，所受到的疲劳伤害由对手承受。"
Cost = 1
BaseAttack = 0
BaseHealth = 0
EvolvedAttack = 0
EvolvedHealth = 0
CardTypeEnum = 2
HeroClassEnum = 2
RarityEnum = 3
TagsArray = PackedStringArray("摄政")
InitialKeywordsFlags = 0
