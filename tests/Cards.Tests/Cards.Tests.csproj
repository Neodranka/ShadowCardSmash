<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>ShadowCardSmash.Tests.Cards</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\src\Domain\**\*.cs" LinkBase="Domain" />
    <Compile Include="..\..\src\Engine\**\*.cs" LinkBase="Engine" />
    <Compile Include="..\..\src\Cards\**\*.cs" Exclude="..\..\src\Cards\Resources\**\*.cs" LinkBase="Cards" />
  </ItemGroup>
</Project>
